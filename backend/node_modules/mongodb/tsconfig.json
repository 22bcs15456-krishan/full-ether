{
  "compilerOptions": {
    /* Core */
    "target": "ES2021",
    "module": "NodeNext",
    "moduleResolution": "node16",

    /* Paths */
    "rootDir": "src",
    "outDir": "dist",

    /* Strictness */
    "strict": true,
    "alwaysStrict": true,

    /* Node environment */
    "types": ["node"],

    /* Performance */
    "skipLibCheck": true,

    /* Output */
    "sourceMap": true,
    "declaration": true,

    /* Safety */
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    /* Optional (recommended) */
    "esModuleInterop": true
  },

  "ts-node": {
    "transpileOnly": true
  },

  "include": ["src/**/*"]
}